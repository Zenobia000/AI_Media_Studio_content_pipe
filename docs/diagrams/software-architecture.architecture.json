  "cards": [
    {
      "dot": "cyan",
      "title": "依賴規則",
      "items": [
        "依賴由上往下：skills → 工具介面 → 領域模組 → core／ledger",
        "領域模組之間不能 import，只透過檔案（07 介面契約）與 SQLite 交接",
        "外部工具一律經過領域模組內的 adapter"
      ]
    },
    {
      "dot": "rose",
      "title": "不交給 AI 的事",
      "items": [
        "approve 需要人的確認原文；headless 執行不能 approve、schedule",
        "狀態轉換、冪等、鎖、預算都在 ledger，skill 繞不過",
        "工具不呼叫 LLM；skill 的產出由工具驗證"
      ]
    },
    {
      "dot": "emerald",
      "title": "誰寫什麼",
      "items": [
        "skill 和它呼叫的工具由同一人負責（tag 標示負責人）",
        "每個 skill 附 evals，改 SKILL.md 要附改前改後結果",
        "schemas/ 介面契約三人共同，改動要三人核准"
      ]
    }
  ]
