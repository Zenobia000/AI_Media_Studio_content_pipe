  "cards": [
    {
      "dot": "cyan",
      "title": "分層原則",
      "items": [
        "skill 寫判斷與流程，agent 依 skill 決定呼叫哪些工具",
        "工具 JSON 進出、不呼叫 LLM，可以重跑",
        "發布確認、冪等、預算寫死在工具裡，skill 繞不過"
      ]
    },
    {
      "dot": "amber",
      "title": "排程",
      "items": [
        "收集每 15 分鐘直接執行工具，不經過 agent",
        "早報、週報用 claude -p 跑 skill，有回合與花費上限",
        "R5 起 changedetection.io（Docker）以 webhook 觸發收集"
      ]
    },
    {
      "dot": "violet",
      "title": "部署注意",
      "items": [
        "WSL 開啟 systemd，並關閉 Windows 自動睡眠",
        "Claude Code 在工作區目錄啟動，skills 由 init 連結進來",
        "金鑰放環境變數或 keyring，不進工作區"
      ]
    }
  ]
