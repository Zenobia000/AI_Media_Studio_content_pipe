  "cards": [
    {
      "dot": "cyan",
      "title": "依賴規則",
      "items": [
        "模組化單體：不拆服務、不用訊息佇列",
        "領域模組之間只透過檔案與 SQLite 交接",
        "外部工具一律經過 adapter，每個都能單獨停用"
      ]
    },
    {
      "dot": "amber",
      "title": "部署注意",
      "items": [
        "WSL 開啟 systemd，並關閉 Windows 自動睡眠",
        "Obsidian 從 Windows 端開 WSL 內的工作區",
        "金鑰放環境變數或 keyring，不進工作區"
      ]
    },
    {
      "dot": "violet",
      "title": "分期上線",
      "items": [
        "R4 起接 X API、ntfy 推播、成效自動回收",
        "R5 起加 changedetection.io（Docker）",
        "R6 起經聚合服務自動發布，另需物件儲存提供暫存公開網址"
      ]
    }
  ]
