{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "資料流｜交棒物、skill 與人工決策點",
    "locale": "zh-TW",
    "quality_profile": "showcase",
    "output": "docs/diagrams/data-flow.html",
    "legend": {
      "entries": {
        "emphasis": {
          "label": "主要交棒物"
        },
        "default": {
          "label": "外部抓取"
        },
        "security": {
          "label": "人工確認關卡"
        },
        "dashed": {
          "label": "回饋"
        },
        "database": {
          "label": "工作區檔案與 SQLite"
        }
      }
    }
  },
  "stages": [
    {
      "label": "收集"
    },
    {
      "label": "選題與建題"
    },
    {
      "label": "補料與草稿"
    },
    {
      "label": "製作與確認"
    },
    {
      "label": "發布與回饋"
    }
  ],
  "nodes": [
    {
      "id": "src",
      "type": "cloud",
      "label": "資訊來源",
      "sublabel": "RSS、GitHub、HN、X",
      "stage": 0,
      "row": 0
    },
    {
      "id": "col",
      "type": "backend",
      "label": "collect 工具",
      "sublabel": "去重、聚類、熱度",
      "stage": 0,
      "row": 1,
      "tag": "Albert"
    },
    {
      "id": "inbox",
