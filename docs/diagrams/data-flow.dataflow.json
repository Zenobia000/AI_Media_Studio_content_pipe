  "cards": [
    {
      "dot": "rose",
      "title": "誰編排",
      "items": [
        "紅色是 skill：由 agent 依 Markdown 決定步驟，可以跳過或補做",
        "綠色是確定性工具：收集與成效回收由排程直接執行",
        "藍色是人：選題、選稿、確認，三個決策點不交給 AI"
      ]
    },
    {
      "dot": "amber",
      "title": "交棒契約",
      "items": [
        "每個交棒物都有 IF 編號，見 SRS 07 介面契約",
        "skill 的產出要先通過工具驗證才算交棒（facts-verify、draft-save）",
        "tag 是負責人；跨人交棒點就是三人的接力點"
      ]
    },
    {
      "dot": "cyan",
      "title": "produce-topic",
      "items": [
        "選題到草稿由 produce-topic（楊舒媁）串起：open-topic → gather-assets → draft-content",
        "一題失敗不影響其他題；重跑時已完成的工具呼叫不會再執行"
      ]
    }
  ]
}
