      "to": "draftc",
      "label": "事實與素材",
      "variant": "emphasis"
    },
    {
      "id": "draftc_drafts",
      "from": "draftc",
      "to": "drafts",
      "label": "新版本",
      "variant": "emphasis"
    },
    {
      "id": "drafts_select",
      "from": "drafts",
      "to": "select",
      "label": "草稿",
      "variant": "emphasis"
    },
    {
      "id": "select_make",
      "from": "select",
      "to": "make",
      "label": "定稿",
      "variant": "emphasis"
    },
    {
      "id": "make_builds",
      "from": "make",
      "to": "builds",
      "label": "成品＋manifest",
      "variant": "emphasis"
    },
    {
      "id": "builds_review",
      "from": "builds",
      "to": "review",
      "label": "預覽",
      "variant": "emphasis"
    },
    {
      "id": "review_approve",
      "from": "review",
      "to": "approve",
      "label": "待確認項",
      "variant": "emphasis"
    },
    {
      "id": "approve_publish",
      "from": "approve",
      "to": "publish",
      "label": "approval",
      "variant": "security"
    },
    {
      "id": "publish_pubs",
      "from": "publish",
