      "row": 2
    },
    {
      "id": "metrics",
      "type": "backend",
      "label": "metrics 工具",
      "sublabel": "手填或自動回收",
      "stage": 4,
      "row": 3,
      "tag": "楊舒媁"
    },
    {
      "id": "retro",
      "type": "security",
      "label": "weekly-retro",
      "sublabel": "週報與建議",
      "stage": 4,
      "row": 4,
      "tag": "楊舒媁"
    }
