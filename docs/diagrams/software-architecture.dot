digraph G {
graph [rankdir=TB, label="軟體架構圖｜分層與模組歸屬（依賴方向由上往下）"];
graph [bgcolor="white", pad="0.4", nodesep="0.45", ranksep="0.6", fontname="Microsoft JhengHei", fontsize=20, labelloc=t, compound=true];
node [shape=box, style="rounded,filled", fillcolor="#eef4fa", color="#42617d", fontname="Microsoft JhengHei", fontsize=13, margin="0.18,0.1"];
edge [fontname="Microsoft JhengHei", fontsize=11, color="#526779", arrowsize=0.75];
subgraph cluster_ui { label="入口層"; style="rounded"; color="#9aa7b3";
node [fillcolor="#eef4fa"]; cli [label="cli（Typer）"]; slash [label=".claude/commands\n/inbox /produce /reel …"]; }
subgraph cluster_app { label="流程層"; style="rounded"; color="#9aa7b3";
orch [label="orchestrator\nJob／鎖／指紋／重跑", fillcolor="#e8e4f6"]; sched [label="scheduler／notify／budget", fillcolor="#e8e4f6"]; }
subgraph cluster_domain { label="領域模組（各自實作 Step 介面）"; style="rounded"; color="#9aa7b3";
collect [label="collect\n收集器、正規化、聚類、熱度、inbox、建題", fillcolor="#e3f0e1"];
fetch [label="fetch\n原文擷取、分層補料、素材盤點", fillcolor="#e3f0e1"];
draft [label="draft\n事實抽取、寫稿、引用檢查、版本", fillcolor="#fdf0dc"];
prod [label="production\nbuild 轉換、字幕、輪播、Reel、規格檢查", fillcolor="#fdf0dc"];
pub [label="publish\nreview、approve、發布包、發布", fillcolor="#e8e4f6"];
fb [label="feedback\n成效、週報、建議", fillcolor="#e8e4f6"]; }
subgraph cluster_infra { label="基礎層（core）"; style="rounded"; color="#9aa7b3";
ws [label="workspace\n路徑、受管區塊、front-matter、原子寫入", fillcolor="#e3f0e1"];
db [label="db\nSQLite、migration、repository", fillcolor="#e3f0e1"];
cfg [label="config／log", fillcolor="#e3f0e1"]; schema [label="schemas\n07 介面契約", fillcolor="#eef4fa"]; }
subgraph cluster_adapters { label="Adapter 層（可替換的外部工具）"; style="rounded"; color="#9aa7b3"; node [fillcolor="#f7f7f7"];
a_col [label="Collector\nrss／github／hn／x／…"]; a_dl [label="Extractor／Downloader\ntrafilatura／yt-dlp／…"];
a_llm [label="LLM\nAnthropic"]; a_asr [label="Aligner／ASR"]; a_render [label="Renderer\nNode CLI"];
a_pub [label="Publisher／Metrics\nIG／Threads／…"]; a_note [label="Notifier\nntfy"]; }
node_r [label="render/（Node）\n模板與元件", fillcolor="#fdf0dc"];
cli -> orch; slash -> cli; sched -> orch;
orch -> collect; orch -> fetch; orch -> draft; orch -> prod; orch -> pub; orch -> fb;
collect -> a_col; fetch -> a_dl; draft -> a_llm; prod -> a_asr; prod -> a_render -> node_r; pub -> a_pub; fb -> a_pub; sched -> a_note;
collect -> ws [lhead=cluster_infra, style=dashed, label="所有領域模組都只依賴 core"];
pub -> db [style=dashed]; draft -> schema [style=dashed];
subgraph cluster_legend { label="負責人"; style="rounded,dashed"; color="#9aa7b3"; fontsize=12;
lg_a [label="Albert Chiang｜素材收集", fillcolor="#e3f0e1"];
lg_c [label="周長曉｜文章與影片", fillcolor="#fdf0dc"];
lg_s [label="楊舒媁｜排程與發布", fillcolor="#e8e4f6"];
lg_a -> lg_c -> lg_s [style=invis]; }
}