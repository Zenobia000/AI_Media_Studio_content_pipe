digraph G {
graph [rankdir=LR, label="ERD｜SQLite 主要資料表（顏色代表負責人）"];
graph [bgcolor="white", pad="0.4", nodesep="0.45", ranksep="0.6", fontname="Microsoft JhengHei", fontsize=20, labelloc=t, compound=true];
node [shape=box, style="rounded,filled", fillcolor="#eef4fa", color="#42617d", fontname="Microsoft JhengHei", fontsize=13, margin="0.18,0.1"];
edge [fontname="Microsoft JhengHei", fontsize=11, color="#526779", arrowsize=0.75];
sources [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#e3f0e1"><tr><td bgcolor="#42617d"><font color="white"><b>sources</b></font></td></tr><tr><td align="left">source_id PK</td></tr><tr><td align="left">url／canonical_url</td></tr><tr><td align="left">kind／publisher／author</td></tr><tr><td align="left">published_at</td></tr><tr><td align="left">first_seen_at</td></tr><tr><td align="left">local_path</td></tr></table>>];
source_signals [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#e3f0e1"><tr><td bgcolor="#42617d"><font color="white"><b>source_signals</b></font></td></tr><tr><td align="left">source_id FK</td></tr><tr><td align="left">collector</td></tr><tr><td align="left">signal</td></tr><tr><td align="left">captured_at</td></tr></table>>];
candidates [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#e3f0e1"><tr><td bgcolor="#42617d"><font color="white"><b>candidates</b></font></td></tr><tr><td align="left">candidate_id PK</td></tr><tr><td align="left">title／title_zh</td></tr><tr><td align="left">tier／score</td></tr><tr><td align="left">cluster_key</td></tr><tr><td align="left">status</td></tr></table>>];
candidate_sources [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#e3f0e1"><tr><td bgcolor="#42617d"><font color="white"><b>candidate_sources</b></font></td></tr><tr><td align="left">candidate_id FK</td></tr><tr><td align="left">source_id FK</td></tr></table>>];
topics [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#e3f0e1"><tr><td bgcolor="#42617d"><font color="white"><b>topics</b></font></td></tr><tr><td align="left">topic_id PK</td></tr><tr><td align="left">title／program／tier</td></tr></table>>];
topic_sources [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#e3f0e1"><tr><td bgcolor="#42617d"><font color="white"><b>topic_sources</b></font></td></tr><tr><td align="left">topic_id FK</td></tr><tr><td align="left">source_id FK</td></tr></table>>];
assets [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#e3f0e1"><tr><td bgcolor="#42617d"><font color="white"><b>assets</b></font></td></tr><tr><td align="left">topic_id＋asset_id PK</td></tr><tr><td align="left">path／type／origin</td></tr><tr><td align="left">source_id FK</td></tr><tr><td align="left">fetch_layer／sha256</td></tr></table>>];
contents [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#e8e4f6"><tr><td bgcolor="#42617d"><font color="white"><b>contents</b></font></td></tr><tr><td align="left">topic_id＋content_id PK</td></tr><tr><td align="left">program／format</td></tr><tr><td align="left">status</td></tr><tr><td align="left">selected_revision</td></tr><tr><td align="left">wave</td></tr></table>>];
agent_runs [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#e8e4f6"><tr><td bgcolor="#42617d"><font color="white"><b>agent_runs</b></font></td></tr><tr><td align="left">run_id PK</td></tr><tr><td align="left">skill／trigger</td></tr><tr><td align="left">status／turns</td></tr><tr><td align="left">started_at／ended_at</td></tr><tr><td align="left">cost_usd</td></tr></table>>];
jobs [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#e8e4f6"><tr><td bgcolor="#42617d"><font color="white"><b>jobs</b></font></td></tr><tr><td align="left">job_id PK</td></tr><tr><td align="left">run_id FK</td></tr><tr><td align="left">kind／target</td></tr><tr><td align="left">status／attempt</td></tr><tr><td align="left">input_fingerprint</td></tr><tr><td align="left">error_code</td></tr><tr><td align="left">cost_usd</td></tr></table>>];
builds [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#fdf0dc"><tr><td bgcolor="#42617d"><font color="white"><b>builds</b></font></td></tr><tr><td align="left">build_id PK</td></tr><tr><td align="left">content_ref FK</td></tr><tr><td align="left">manifest_path</td></tr><tr><td align="left">status／stale</td></tr></table>>];
approvals [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#e8e4f6"><tr><td bgcolor="#42617d"><font color="white"><b>approvals</b></font></td></tr><tr><td align="left">approval_id PK</td></tr><tr><td align="left">content_ref FK</td></tr><tr><td align="left">build_id FK</td></tr><tr><td align="left">run_id FK／human_quote</td></tr><tr><td align="left">approved_at／revoked_at</td></tr></table>>];
publications [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#e8e4f6"><tr><td bgcolor="#42617d"><font color="white"><b>publications</b></font></td></tr><tr><td align="left">publication_id PK</td></tr><tr><td align="left">content_ref FK</td></tr><tr><td align="left">build_id FK</td></tr><tr><td align="left">platform／status</td></tr><tr><td align="left">url／published_at</td></tr></table>>];
metric_snapshots [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#e8e4f6"><tr><td bgcolor="#42617d"><font color="white"><b>metric_snapshots</b></font></td></tr><tr><td align="left">publication_id FK</td></tr><tr><td align="left">captured_at</td></tr><tr><td align="left">source／metric_version</td></tr><tr><td align="left">metrics_json</td></tr></table>>];
sources -> source_signals [label="1:N"]; candidates -> candidate_sources; sources -> candidate_sources;
topics -> topic_sources; sources -> topic_sources; topics -> assets [label="1:N"]; sources -> assets [style=dashed, label="0..1"];
topics -> contents [label="1:N"]; contents -> builds [label="1:N"]; contents -> jobs [style=dashed, label="target"];
builds -> approvals; contents -> approvals; builds -> publications; contents -> publications [label="1:N"];
publications -> metric_snapshots [label="1:N"]; candidates -> topics [style=dashed, label="picked"];
agent_runs -> jobs [label="1:N"]; agent_runs -> approvals [style=dashed, label="0..1"];
}