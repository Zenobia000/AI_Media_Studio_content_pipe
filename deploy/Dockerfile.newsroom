# The collect and fetch part (src/newsroom): the scheduler and the tools. Build from the repository root:
#   docker compose -f AIHOT/docker-compose.yml -f deploy/newsroom.yml up -d --build newsroom
# WITH_BROWSER=1 also installs Chromium for fetch layer 4 (page recording); it adds several hundred MB.
FROM python:3.12-slim
ARG WITH_BROWSER=0
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
COPY skills ./skills
COPY AIHOT/database ./AIHOT/database
RUN pip install --no-cache-dir . yt-dlp gallery-dl \
 && if [ "$WITH_BROWSER" = "1" ]; then pip install --no-cache-dir ".[record]" && playwright install --with-deps chromium; fi
ENV PYTHONUNBUFFERED=1 NEWSROOM_HOME=/data/workspace
CMD ["newsroom", "run-scheduler"]
